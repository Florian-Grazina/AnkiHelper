<Window x:Class="AnkiHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AnkiHelper"
        xmlns:conv="clr-namespace:AnkiHelper.Convertors"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        Title="Anki Helper"
        Height="540"
        Width="520"
        MinHeight="300"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Face}"
        FontFamily="Microsoft Sans Serif"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <!-- Drop the Windows 11 chrome: the Win98 frame and title bar below are drawn by hand -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="26"
                      ResizeBorderThickness="4"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- Win98 system palette. Bevel* brushes are only for 3D edges; the others say what they paint. -->
        <SolidColorBrush x:Key="Face" Color="#C0C0C0" />
        <SolidColorBrush x:Key="BevelHighlight" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BevelLight" Color="#DFDFDF" />
        <SolidColorBrush x:Key="BevelShadow" Color="#808080" />
        <SolidColorBrush x:Key="BevelDarkShadow" Color="#000000" />
        <SolidColorBrush x:Key="WindowText" Color="#000000" />
        <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SelectionBackground" Color="#000080" />
        <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TitleBarText" Color="#FFFFFF" />
        <LinearGradientBrush x:Key="ActiveTitleBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#000080" Offset="0" />
            <GradientStop Color="#1084D0" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InactiveTitleBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#808080" Offset="0" />
            <GradientStop Color="#B5B5B5" Offset="1" />
        </LinearGradientBrush>

        <!-- 50% gray/white dither used for scrollbar tracks -->
        <DrawingBrush x:Key="Dither" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource BevelHighlight}" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Face}" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Raised push button. Focused: black outline + dotted focus rectangle. Pressed: flat, content shifted.
             Highlight is outside and Light inside, the reverse of RaisedBlockTemplate: that is how Win98 draws push buttons. -->
        <ControlTemplate x:Key="RaisedButtonTemplate" TargetType="ButtonBase">
            <Grid Background="{TemplateBinding Background}">
                <Grid x:Name="Bevel">
                    <Border x:Name="OuterShadow" BorderBrush="{StaticResource BevelDarkShadow}" BorderThickness="0,0,1,1" />
                    <Border x:Name="OuterLight" BorderBrush="{StaticResource BevelHighlight}" BorderThickness="1,1,0,0" Margin="0,0,1,1" />
                    <Border x:Name="InnerShadow" BorderBrush="{StaticResource BevelShadow}" BorderThickness="0,0,1,1" Margin="1" />
                    <Border x:Name="InnerLight" BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" Margin="1,1,2,2" />
                </Grid>
                <Border x:Name="Outline" BorderBrush="{StaticResource BevelDarkShadow}" BorderThickness="1" Visibility="Collapsed" />
                <ContentPresenter x:Name="Content"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
                <Rectangle x:Name="FocusRect"
                           Margin="4"
                           Stroke="{StaticResource BevelDarkShadow}"
                           StrokeThickness="1"
                           StrokeDashArray="1 1"
                           Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bevel" Property="Margin" Value="1" />
                    <Setter TargetName="FocusRect" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bevel" Property="Margin" Value="1" />
                    <Setter TargetName="OuterShadow" Property="BorderBrush" Value="{StaticResource BevelShadow}" />
                    <Setter TargetName="OuterLight" Property="BorderBrush" Value="{StaticResource BevelShadow}" />
                    <Setter TargetName="InnerShadow" Property="BorderBrush" Value="{StaticResource Face}" />
                    <Setter TargetName="InnerLight" Property="BorderBrush" Value="{StaticResource Face}" />
                    <Setter TargetName="Content" Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="1" Y="1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BevelShadow}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Plain raised edge (window frame, scrollbar thumb). Light outside, Highlight inside: Win98 EDGE_RAISED, intentionally
             the reverse of RaisedButtonTemplate. -->
        <ControlTemplate x:Key="RaisedBlockTemplate" TargetType="Control">
            <Grid Background="{StaticResource Face}">
                <Border BorderBrush="{StaticResource BevelDarkShadow}" BorderThickness="0,0,1,1" />
                <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" Margin="0,0,1,1" />
                <Border BorderBrush="{StaticResource BevelShadow}" BorderThickness="0,0,1,1" Margin="1" />
                <Border BorderBrush="{StaticResource BevelHighlight}" BorderThickness="1,1,0,0" Margin="1,1,2,2" />
            </Grid>
        </ControlTemplate>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Face}" />
            <Setter Property="Foreground" Value="{StaticResource WindowText}" />
            <Setter Property="MinWidth" Value="75" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource RaisedButtonTemplate}" />
        </Style>

        <!-- Title bar _ □ X buttons; glyphs come from the Marlett system font, like the real thing -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Marlett" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <Style x:Key="ScrollArrowStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="{StaticResource Face}" />
            <Setter Property="Foreground" Value="{StaticResource WindowText}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Marlett" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template" Value="{StaticResource RaisedButtonTemplate}" />
        </Style>

        <Style x:Key="ScrollPageStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{StaticResource Dither}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Style="{StaticResource ScrollArrowStyle}" Content="5" Command="ScrollBar.LineUpCommand" />
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource RaisedBlockTemplate}" MinHeight="8" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrowStyle}" Content="6" Command="ScrollBar.LineDownCommand" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{StaticResource Dither}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Grid.Column="0" Style="{StaticResource ScrollArrowStyle}" Content="3" Command="ScrollBar.LineLeftCommand" />
                                    <Track x:Name="PART_Track" Grid.Column="1">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Template="{StaticResource RaisedBlockTemplate}" MinWidth="8" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageStyle}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollArrowStyle}" Content="4" Command="ScrollBar.LineRightCommand" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sunken field: shared frame for TextBox and ComboBox -->
        <ControlTemplate x:Key="SunkenFrameTemplate" TargetType="ContentControl">
            <Grid>
                <Border BorderBrush="{StaticResource BevelShadow}" BorderThickness="1,1,0,0" />
                <Border BorderBrush="{StaticResource BevelHighlight}" BorderThickness="0,0,1,1" />
                <Border BorderBrush="{StaticResource BevelDarkShadow}" BorderThickness="1,1,0,0" Margin="1" />
                <Border BorderBrush="{StaticResource BevelLight}" BorderThickness="0,0,1,1" Margin="1" />
                <Border Background="{StaticResource WindowBackground}" Margin="2">
                    <ContentPresenter />
                </Border>
            </Grid>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource WindowText}" />
            <Setter Property="CaretBrush" Value="{StaticResource WindowText}" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionBackground}" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ContentControl Template="{StaticResource SunkenFrameTemplate}" Focusable="False">
                            <Grid>
                                <!-- Placeholder: shows the TextBox's Tag while it is empty -->
                                <TextBlock x:Name="Placeholder"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource BevelShadow}"
                                           Margin="{TemplateBinding Padding}"
                                           Padding="2,0"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </ContentControl>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win98 drop-down list: sunken field, raised arrow button inside it, navy selection when focused -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource WindowText}" />
            <Setter Property="Height" Value="21" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ContentControl Template="{StaticResource SunkenFrameTemplate}" Focusable="False">
                                <Grid>
                                    <Border x:Name="SelectionBox" Margin="1,1,18,1" Padding="2,0">
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False" />
                                    </Border>
                                    <!-- Full-width toggle: clicking the text opens the list too -->
                                    <ToggleButton Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Grid Width="16" HorizontalAlignment="Right" Background="{StaticResource Face}">
                                                        <Border x:Name="OuterShadow" BorderBrush="{StaticResource BevelDarkShadow}" BorderThickness="0,0,1,1" />
                                                        <Border x:Name="OuterLight" BorderBrush="{StaticResource BevelLight}" BorderThickness="1,1,0,0" Margin="0,0,1,1" />
                                                        <Border x:Name="InnerShadow" BorderBrush="{StaticResource BevelShadow}" BorderThickness="0,0,1,1" Margin="1" />
                                                        <Border x:Name="InnerLight" BorderBrush="{StaticResource BevelHighlight}" BorderThickness="1,1,0,0" Margin="1,1,2,2" />
                                                        <TextBlock x:Name="Arrow"
                                                                   Text="6"
                                                                   FontFamily="Marlett"
                                                                   FontSize="10"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="OuterShadow" Property="BorderBrush" Value="{StaticResource BevelShadow}" />
                                                        <Setter TargetName="OuterLight" Property="BorderBrush" Value="{StaticResource BevelShadow}" />
                                                        <Setter TargetName="InnerShadow" Property="BorderBrush" Value="{StaticResource Face}" />
                                                        <Setter TargetName="InnerLight" Property="BorderBrush" Value="{StaticResource Face}" />
                                                        <Setter TargetName="Arrow" Property="Margin" Value="1,1,0,0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </ContentControl>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   Focusable="False">
                                <Border Background="{StaticResource WindowBackground}"
                                        BorderBrush="{StaticResource BevelDarkShadow}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                    <Condition Property="IsDropDownOpen" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SelectionBox" Property="Background" Value="{StaticResource SelectionBackground}" />
                                <Setter TargetName="SelectionBox" Property="TextElement.Foreground" Value="{StaticResource SelectionText}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{StaticResource SelectionBackground}" />
                                        <Setter TargetName="Item" Property="TextElement.Foreground" Value="{StaticResource SelectionText}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Etched group box -->
        <Style TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="{StaticResource BevelShadow}" BorderThickness="1" Margin="0,6,1,1" />
                            <Border BorderBrush="{StaticResource BevelHighlight}" BorderThickness="1" Margin="1,7,0,0" />
                            <Border Background="{StaticResource Face}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,0" Padding="2,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <ContentPresenter Margin="9,20,9,9" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- When maximized, the system pushes the window frame off-screen: compensate so nothing gets clipped -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="8" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- Raised window frame -->
            <Control Template="{StaticResource RaisedBlockTemplate}" Focusable="False" IsTabStop="False" />

            <DockPanel Margin="4">
                <!-- Title bar: navy gradient when active, gray when inactive -->
                <Grid DockPanel.Dock="Top" Height="18">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="{StaticResource ActiveTitleBar}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource TitleBarText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource InactiveTitleBar}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Face}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold"
                               Margin="3,0"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                        <Button Style="{StaticResource CaptionButtonStyle}" Content="0" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click" />
                        <Button Click="MaximizeRestore_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                    <Setter Property="Content" Value="1" />
                                    <Setter Property="ToolTip" Value="Maximize" />
                                    <Setter Property="AutomationProperties.Name" Value="Maximize" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Content" Value="2" />
                                            <Setter Property="ToolTip" Value="Restore" />
                                            <Setter Property="AutomationProperties.Name" Value="Restore" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Content="r" ToolTip="Close" AutomationProperties.Name="Close" Margin="2,0,0,0" Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- Status bar with size grip -->
                <Grid DockPanel.Dock="Bottom" Height="20" Margin="0,2,0,0">
                    <!-- Shallow sunken panel -->
                    <Border BorderBrush="{StaticResource BevelShadow}" BorderThickness="1,1,0,0" Margin="0,2,0,0">
                        <Border BorderBrush="{StaticResource BevelHighlight}" BorderThickness="0,0,1,1">
                            <TextBlock Margin="3,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Ready" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="Please wait..." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Border>
                    <Grid HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Width="13"
                          Height="13"
                          Background="Transparent"
                          WindowChrome.ResizeGripDirection="BottomRight">
                        <!-- No IsHitTestVisibleInChrome here: it would take priority over the resize grip -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="p" FontFamily="Marlett" FontSize="13" Foreground="{StaticResource BevelHighlight}" />
                        <TextBlock Text="o" FontFamily="Marlett" FontSize="13" Foreground="{StaticResource BevelShadow}" />
                    </Grid>
                </Grid>

                <!-- Client area -->
                <Grid>
                    <Grid Margin="8,10,8,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Deck selector -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="_Deck:"
                                   Target="{Binding ElementName=DeckComboBox}"
                                   Padding="0"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                            <ComboBox x:Name="DeckComboBox"
                                      Grid.Column="1"
                                      SelectedItem="{Binding SelectedDeckId, Mode=TwoWay}"
                                      ItemsSource="{Binding DeckNameCollection}" />
                            <Button Grid.Column="2"
                                    Content="_Refresh"
                                    Margin="6,0,0,0"
                                    Command="{Binding RefreshDecksCommand}" />
                        </Grid>

                        <!-- JSON input -->
                        <GroupBox Grid.Row="2" Header="Cards (_JSON)">
                            <TextBox FontFamily="Courier New"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding NewVocabsJson}">
                                <TextBox.Tag>
                                    <sys:String xml:space="preserve">Paste a JSON array of cards:
[
  {
    "Lesson": "5",
    "WordType": "N",
    "Japanese": "猫 (ねこ)",
    "English": "cat"
  }
]

WordType: Adj | Phra | N | V | Prep | Adv</sys:String>
                                </TextBox.Tag>
                            </TextBox>
                        </GroupBox>

                        <!-- Error: Win98 critical icon + message -->
                        <DockPanel Grid.Row="3"
                                   Margin="2,8,0,0"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Top" Margin="0,0,6,0">
                                <Ellipse Fill="#FF0000" Stroke="#800000" />
                                <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="#FFFFFF" StrokeThickness="2" />
                            </Grid>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Actions, right-aligned like a Win98 dialog -->
                        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="_Add Cards" Command="{Binding AddCardsCommand}" />
                            <Button Content="_Open Anki" Margin="6,0,0,0" Command="{Binding OpenAnkiCommand}" />
                            <Button Content="Add _CSS" Margin="6,0,0,0" Command="{Binding AddCssCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Busy: hourglass cursor and input blocked, no fake dialog -->
                    <Border Background="Transparent"
                            Cursor="Wait"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
